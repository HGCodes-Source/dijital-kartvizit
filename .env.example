# Oturum imzalama anahtari - rastgele uzun bir metin girin (mutlaka degistirin!)
SESSION_SECRET=bu-anahtari-mutlaka-degistir-cok-uzun-ve-rastgele-yap

# Sitenin yayindaki tam adresi (QR kod ve link paylasimi icin kullanilir)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase projenizin bilgileri (Supabase Panel > Project Settings > API)
# SUPABASE_URL   -> "Project URL"
# SUPABASE_SERVICE_ROLE_KEY -> "service_role" anahtari (ANON KEY DEGIL!)
#   Bu anahtar tum tabloya tam erisim verir, SADECE sunucu tarafinda
#   kullanilir ve asla tarayiciya/istemciye gonderilmez. Kimseyle paylasmayin.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=buraya-service-role-anahtarini-yapistir
